{
  "name": "dsh-chat-tide",
  "version": "0.2.0",
  "description": "Tide — chat memory and selective waking for DSH",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./client": "./lib/client.js",
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "presets",
    "scripts",
    "probes",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.3.0-0"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "sqlite-vec": "^0.1.9",
    "@huggingface/transformers": "3.7.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=0.1.0"
  },
  "scripts": {
    "test": "node scripts/run-checks.mjs --skip-model"
  },
  "license": "MIT",
  "author": "FakerKonzo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FakerKonzo/dsh-chat-tide.git"
  },
  "homepage": "https://github.com/FakerKonzo/dsh-chat-tide#readme",
  "bugs": {
    "url": "https://github.com/FakerKonzo/dsh-chat-tide/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tide",
    "memory",
    "agent"
  ],
  "icon": "assets/icon.png",
  "engines": {
    "node": ">=22.5.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "private": false
}
